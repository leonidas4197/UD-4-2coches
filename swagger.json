{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "API de Concesionarios y Coches",
    "description": "API para gestionar concesionarios y coches."
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": ["http"],
  "paths": {
    "/concesionarios": {
      "get": {
        "summary": "Obtener todos los concesionarios",
        "responses": {
          "200": {
            "description": "Lista de concesionarios",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Concesionario"
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un nuevo concesionario",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Datos del concesionario",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Concesionario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Concesionario creado con éxito."
          },
          "400": {
            "description": "Error en la solicitud."
          }
        }
      }
    },
    "/concesionarios/{id}": {
      "get": {
        "summary": "Obtener un concesionario por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del concesionario",
            "schema": {
              "$ref": "#/definitions/Concesionario"
            }
          },
          "404": {
            "description": "Concesionario no encontrado."
          }
        }
      },
      "put": {
        "summary": "Actualizar un concesionario por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Datos actualizados del concesionario",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Concesionario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Concesionario actualizado con éxito."
          },
          "404": {
            "description": "Concesionario no encontrado."
          }
        }
      },
      "delete": {
        "summary": "Borrar un concesionario por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          }
        ],
        "responses": {
          "200": {
            "description": "Concesionario borrado con éxito."
          },
          "404": {
            "description": "Concesionario no encontrado."
          }
        }
      }
    },
    "/concesionarios/{id}/coches": {
      "get": {
        "summary": "Obtener todos los coches de un concesionario",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de coches del concesionario",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Coche"
              }
            }
          },
          "404": {
            "description": "Concesionario no encontrado."
          }
        }
      },
      "post": {
        "summary": "Añadir un coche a un concesionario",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Datos del coche",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Coche"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Coche añadido con éxito."
          },
          "404": {
            "description": "Concesionario no encontrado."
          }
        }
      }
    },
    "/concesionarios/{id}/coches/{cocheId}": {
      "get": {
        "summary": "Obtener un coche por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          },
          {
            "in": "path",
            "name": "cocheId",
            "required": true,
            "type": "string",
            "description": "ID del coche"
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del coche",
            "schema": {
              "$ref": "#/definitions/Coche"
            }
          },
          "404": {
            "description": "Coche o concesionario no encontrado."
          }
        }
      },
      "put": {
        "summary": "Actualizar un coche por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          },
          {
            "in": "path",
            "name": "cocheId",
            "required": true,
            "type": "string",
            "description": "ID del coche"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Datos actualizados del coche",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Coche"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Coche actualizado con éxito."
          },
          "404": {
            "description": "Coche o concesionario no encontrado."
          }
        }
      },
      "delete": {
        "summary": "Borrar un coche por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "ID del concesionario"
          },
          {
            "in": "path",
            "name": "cocheId",
            "required": true,
            "type": "string",
            "description": "ID del coche"
          }
        ],
        "responses": {
          "200": {
            "description": "Coche borrado con éxito."
          },
          "404": {
            "description": "Coche o concesionario no encontrado."
          }
        }
      }
    }
  },
  "definitions": {
    "Concesionario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único del concesionario"
        },
        "coches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Coche"
          }
        }
      },
      "required": ["id"]
    },
    "Coche": {
      "type": "object",
      "properties": {
        "cocheId": {
          "type": "string",
          "description": "Identificador único del coche"
        },
        "marca": {
          "type": "string",
          "description": "Marca del coche"
        },
        "modelo": {
          "type": "string",
          "description": "Modelo del coche"
        }
      },
      "required": ["cocheId", "marca", "modelo"]
    }
  }
}
